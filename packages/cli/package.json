{
  "name": "@bytethedeveloper/rendrix",
  "version": "0.4.0",
  "description": "Compile HTML/CSS and TypeScript applications into native windows rendered by Rendrix",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "rendrix",
    "rendrix",
    "native",
    "html",
    "css",
    "typescript",
    "quickjs",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteTheDev/Rendrix.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ByteTheDev/Rendrix#readme",
  "bin": {
    "rendrix": "dist/rendrix.mjs"
  },
  "exports": {
    "./types": "./types/app.d.ts"
  },
  "files": [
    "dist",
    "src/electron-compat/runtime",
    "templates",
    "types",
    "native",
    "README.md",
    "hosts.json"
  ],
  "scripts": {
    "build": "bun build bin/rendrix.mjs --target=node --outfile=dist/rendrix.mjs",
    "prepack": "node scripts/pack-native.mjs copy && bun run build",
    "postpack": "node scripts/pack-native.mjs clean",
    "release:archive": "node scripts/pack-release.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "postcss": "^8.5.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
