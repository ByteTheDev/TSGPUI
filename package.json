{
  "name": "rendrix-monorepo",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "node packages/cli/bin/rendrix.mjs build --project examples/counter",
    "dev": "node packages/cli/bin/rendrix.mjs dev --project examples/counter",
    "compile": "node packages/cli/bin/rendrix.mjs compile --project examples/counter",
    "host": "node packages/cli/bin/rendrix.mjs host build",
    "doctor": "node packages/cli/bin/rendrix.mjs doctor",
    "rendrix": "node packages/cli/bin/rendrix.mjs",
    "test": "node --test packages/cli/test/*.test.mjs",
    "typecheck": "tsc --noEmit -p examples/counter/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "postcss": "^8.5.6"
  }
}
