{
  "name": "rendrix-monorepo",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "rendrix": "node packages/cli/bin/rendrix.mjs",
    "doctor": "node packages/cli/bin/rendrix.mjs doctor",
    "runtime": "cargo build --release -p rendrix-runtime --manifest-path engine/Cargo.toml",
    "example": "node packages/cli/bin/rendrix.mjs dev examples/app-counter",
    "example:build": "node packages/cli/bin/rendrix.mjs build examples/app-counter",
    "e2e": "node scripts/e2e.mjs",
    "test": "cargo test --workspace --manifest-path engine/Cargo.toml && node --test packages/cli/test/*.test.mjs",
    "test:cli": "node --test packages/cli/test/*.test.mjs",
    "bench": "cargo run --release -p rendrix-runtime --manifest-path engine/Cargo.toml -- bench 1000",
    "typecheck": "node packages/cli/bin/rendrix.mjs check examples/app-counter"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
